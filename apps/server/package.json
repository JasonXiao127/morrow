{
  "name": "@morrow/server",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "node --watch dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "reset-password": "node dist/reset-password.js"
  },
  "dependencies": {
    "@fastify/compress": "^8.0.0",
